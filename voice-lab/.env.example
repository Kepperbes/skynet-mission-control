# voice-lab needs an OpenAI key with Realtime API access (for speech-in / speech-out).
# Provide it either by exporting OPENAI_API_KEY in your shell, or by putting it in a
# repo-root .env (Bun auto-loads .env from the directory you run the command in).
OPENAI_API_KEY=sk-proj-...your-key-with-realtime-access...

# Optional — port the token server listens on (the app calls http://localhost:8099)
PORT=8099
